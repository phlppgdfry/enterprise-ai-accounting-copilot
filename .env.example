# Run python -m accounting_copilot.bootstrap to generate real local development keys.
ACCOUNTING_DB=data/accounting.sqlite3
ACCOUNTING_API_KEYS={}
ACCOUNTING_AI_MODE=disabled
# To enable paid Azure calls: set ACCOUNTING_AI_MODE=azure and configure these.
# Endpoints are resource roots WITHOUT /openai/v1 or documentintelligence suffixes.
AZURE_DOCUMENT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Prefer managed identity in Azure; optional keys for local development only.
AZURE_DOCUMENT_KEY=
AZURE_OPENAI_KEY=
